# Optional. Copy to frontend/.env.local if needed.

# Where the dev server proxies /api (default http://127.0.0.1:8000)
# VITE_API_PROXY=http://127.0.0.1:8000

# Only set this when the built frontend is served from a different origin than the API,
# e.g. VITE_API_BASE=https://hubs-api.example.com  (leave empty to use same-origin /api)
# VITE_API_BASE=
