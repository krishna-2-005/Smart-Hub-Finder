  "assumptions": [
    {
      "topic": "Hub identification",
      "text": "A placemark is treated as a hub only if it carries a 'Hub ID' attribute (or both 'Hub' and 'Cluster'). Demand points, competitor points, screening records, cluster/region polygons and drawn lines are classified separately and are never treated as hubs.",
      "inferred": "no"
    },
    {
      "topic": "Hub coordinates",
      "text": "Hubs are stored in the KML as service-area polygons without an explicit hub point. The hub location used for search and routing is the polygon centroid (360 hubs) or, where the centroid falls outside a concave polygon, an interior point guaranteed to lie inside it (1 hubs). Original polygon coordinates are preserved unchanged.",
      "inferred": "yes"
    },
    {
      "topic": "Cluster names",
      "text": "Cluster attribute values are matched case- and punctuation-insensitively, and a trailing 'Cluster' is ignored when matching boundary polygons, so variants such as Borabanda = ['Borabanda', 'borabanda'], Kukatpally = ['Kukatpally', 'kukatpally'], Miyapur = ['Miyapur', 'miyapur'], Nallagandla = ['Nallagandla', 'nallagandla'] are one cluster.",
      "inferred": "yes"
    },
    {
      "topic": "Operational status",
      "text": "The 'Hub status' attribute is used as given. Only 'Live' counts as active; 'Not Live' and 'To be made live' are inactive and can be excluded from nearest-hub searches.",
      "inferred": "no"
    },
    {
      "topic": "Regions",
      "text": "Inferred: region polygons named South/East/North are matched to the hub 'Line' attribute values southern_hyd/eastern_hyd/northern_hyd by compass direction.",
      "inferred": "yes"
    },
    {
      "topic": "Demand hotspot (PMF plus-code cell)",
      "text": "Points carrying USERS/DELS/DEL_BUCKET demand metrics per Plus Code cell.",
      "inferred": "yes"
    },
    {
      "topic": "Competitor live location (Snabbit)",
      "text": "Folder name 'Snabbit live pluscodes'; Snabbit is listed as a competitor in the hub Competition Intelligence attributes.",
      "inferred": "yes"
    },
    {
      "topic": "Hub type",
      "text": "The KML has no explicit hub type/category field, so hub_type is stored as null. 'Cluster Mapping' (competitive / non-competitive) and the PMF demand level are exposed as separate attributes.",
      "inferred": "no"
    }
  ]
