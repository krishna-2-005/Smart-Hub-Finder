# Copy to backend/.env and fill in what you need. Never commit backend/.env.

# --- Routing provider -----------------------------------------------------
# auto  = Google Routes API when GOOGLE_MAPS_API_KEY is set, otherwise OSRM
# google | osrm | ors  = force one provider (fails honestly if not configured)
ROUTING_PROVIDER=auto

# Google Maps Platform key with the "Routes API" enabled (billing account required).
# Enables two-wheeler mode and traffic-aware driving times.
GOOGLE_MAPS_API_KEY=

# OpenRouteService key (free tier at https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=

# OSRM servers (no key). Defaults are the public OpenStreetMap demo servers,
# which are fair-use only. For production, run your own OSRM and point these at it.
OSRM_DRIVING_URL=https://router.project-osrm.org
OSRM_CYCLING_URL=https://routing.openstreetmap.de/routed-bike
OSRM_WALKING_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_TIMEOUT_S=25

# --- Data -------------------------------------------------------------------
# Source KML processed on first start if data/processed is empty.
# SOURCE_KML=../Akhil Copy.kml
# DATA_DIR=../data
# EXPORTS_DIR=../exports

# --- API ----------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173
LOG_LEVEL=INFO
